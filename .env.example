# Copie para .env (que está no .gitignore). NUNCA versione valores reais.

# Webhook (usado pela API; em dev prefira: dotnet user-secrets set "Webhook:Secret" "<valor>")
Webhook__Secret=troque-por-um-segredo-forte

# Broker ativo: Kafka | RabbitMq
Messaging__Broker=RabbitMq

# Observabilidade (opcional): ligue para exportar traces/métricas/logs ao collector
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Telegram (automações de ops, módulo 12)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Auto-detecção de erros (módulo 13)
# ES_URL=http://localhost:9200
# GH_REPO=owner/repo
